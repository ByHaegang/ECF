{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/EspaceCommande/styles.css') }}">
{% endblock %}

{% block title %}Espace Commande
{% endblock %}

{% block body %}
	<div class="espace-commande">
		<h2>Passer une commande</h2>
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="{{ label }}">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		<form method="POST" data-turbo="false">

			<input type="hidden" name="_token" value="{{ csrf_token('espaceCommande-form') }}">


			<div class="name">
				<label for="name">Nom :</label>
				<input type="text" id="name" name="name" value="{{ app.session.get('user_nom') }}" required>
			</div>
			<div class="email">
				<label for="email">Email :</label>
				<input type="text" id="email" name="email" value="{{ app.session.get('user_email') }}" required>
			</div>
			<div class="prenom">
				<label for="prenom">Prénom :</label>
				<input type="text" id="prenom" name="prenom" value="{{ app.session.get('user_prenom') }}" required>
			</div>
			<div class="heure-date-prestation">
				<div class="DateHeure">
					<label for="heurePrestation">Heure de la prestation :</label>
					<input type="time" id="heurePrestation" name="heurePrestation" required>
				</div>
				<div class="DateHeure">
					<label for="datePrestation">Date de la prestation :</label>
					<input type="date" id="datePrestation" name="datePrestation" required>
				</div>
			</div>
			<div class="lieu-prestation">
				<label for="villePrestation">Ville :</label>
				<input type="text" id="villePrestation" name="villePrestation" required>
			</div>
			<div class="gsm">
				<label for="gsm">Numéro de téléphone :</label>
				<input type="tel" id="gsm" name="gsm" required>
			</div>
			<div class="menu">
				<label for="menu">Menu :</label>
				<select id="menu" name="menu">
					<option>Tous les menus</option>
					{% for menu in menus %}
						<option value="{{ menu.menu_id }}" data-min="{{ menu.nombre_personne_minimum }}" {% if menu_id_selectionne == menu.menu_id %} selected {% endif %}>
							{{ menu.titre }}
						</option>
					{% endfor %}
				</select>
			</div>
			<div class="nombre-personne">
				<label for="nombrePersonne">Nombre de personnes :</label>
				<input type="number" id="nombrePersonne" name="nombrePersonne" min="0" required>
			</div>
			<button type="submit" class="btn-form">Commander</button>
		</form>
	</div>
{% endblock %}
